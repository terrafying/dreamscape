ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Anthropic model (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: Supabase auth + server-side metadata updates
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Stripe billing
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Free LLM providers (no credit card needed)
# Groq: https://console.groq.com — 14,400 req/day free, fastest inference
GROQ_API_KEY=your_groq_api_key_here
# Groq model (default: openai/gpt-oss-120b — free, 120B params)
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free models (50 req/day — use as secondary fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Leave unset for Auto mode: the server ranks the live OpenRouter catalog and
# picks the best cheap (free-tier-first) model every 15 min, with automatic
# failover on errors. Set this to pin a specific model and disable auto.
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional: OpenAI API key (paid) — used with gpt-4.1-mini by default
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI text model (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Free OpenAI via your ChatGPT subscription (Codex OAuth, no API key needed):
#   1. Run once:  npx openai-oauth login   (stores creds in ~/.codex/auth.json)
#   2. Nothing else needed locally — the server auto-detects the credentials.
# For serverless (Vercel), paste the contents of ~/.codex/auth.json below.
# Note: OAuth refresh tokens rotate, so re-copy occasionally on serverless.
OPENAI_OAUTH_AUTH_JSON=
# OAuth model override (default: gpt-5.4-mini — must be a Codex-supported model)
OPENAI_OAUTH_MODEL=gpt-5.4-mini
# Per-user "Sign in with ChatGPT" (manual paste flow) — usually no changes needed:
# redirect URI must stay the Codex-registered localhost one; override only if you
# know what you're doing. Codex client version is only sent when listing models.
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_CODEX_CLIENT_VERSION=0.144.1

# ElevenLabs TTS — https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ElevenLabs model (default: eleven_multilingual_v2)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voices: comma-separated "voiceId:Label" pairs. First = default.
# Browse and find voice IDs at: https://elevenlabs.io/voice-library
# Known spiritual voices: "21m00Tcm4TlvDq8ikWAM:Rachel" (default ElevenLabs voice)
# For premium voices (AImee, Jameson, Scottish Grandfather) — find your own IDs:
#   1. Go to https://elevenlabs.io/voice-library
#   2. Find a voice you like, click it, copy the ID from the URL
#   3. Add it here as "ID:Display Name"
NEXT_PUBLIC_ELEVENLABS_VOICES="21m00Tcm4TlvDq8ikWAM:Rachel,EXTERNAL_ID:Soulful,EXTERNAL_ID:Scottish Grandfather"

# ---------------------------------------------------------------------------
# Media generation (image + TTS fallback). All model IDs live in lib/models.ts
# and are overridable here. Verify your keys against the live providers with:
#   npm run verify:providers
# ---------------------------------------------------------------------------

# Image generation chain: Replicate Flux Schnell → Gemini (AI Gateway) → OpenAI
REPLICATE_API_TOKEN=your_replicate_api_token
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Gemini 2.5 Flash Image via Vercel AI Gateway (automatic OIDC on Vercel;
# locally needs a gateway key): https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
GEMINI_IMAGE_MODEL=google/gemini-2.5-flash-image
# OpenAI image model (default: gpt-image-1-mini — dall-e is deprecated on
# current OpenAI accounts; gpt-image returns b64_json only, handled internally)
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Video generation ("Living Vision" on vision boards) — Replicate official-model
# endpoint, resumable: predictions are polled, results cached. Default is the
# newest cheap Hailuo tier (verified $0.0074/s p50); full-quality tier:
#   minimax/hailuo-2.3
REPLICATE_VIDEO_MODEL=minimax/hailuo-2.3-fast

# Music / soundtrack generation ("Soundtrack" on vision boards) — Replicate
# meta/musicgen (flat $0.10/clip). NOTE: versioned-endpoint only; the app
# resolves the latest version automatically. Variant via REPLICATE_AUDIO_VERSION:
#   stereo-melody-large (default) | stereo-large | large | melody-large | medium | small
REPLICATE_AUDIO_MODEL=meta/musicgen
REPLICATE_AUDIO_VERSION=stereo-melody-large
REPLICATE_AUDIO_FORMAT=mp3

# TTS fallback chain: ElevenLabs → Replicate MiniMax Speech 02 HD
REPLICATE_TTS_MODEL=minimax/speech-02-hd
REPLICATE_TTS_VOICE=English_Wiselady

# Resend — email for weekly digests + notifications
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=dreams@dreamscape.quest

# Cron secret (Vercel cron authorization)
CRON_SECRET=your_cron_secret_here
